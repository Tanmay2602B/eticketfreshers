# Safe Example Local Environment Configuration
# DO NOT put real values or production secrets into this file.

# Supabase — public keys only (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# Supabase — server-only secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Admin email — used to identify admin user (server-side only)
ADMIN_EMAIL=
